# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# Railway: Variables -> Add Reference -> Postgres -> DATABASE_URL
DATABASE_URL=postgresql://flymasters:flymasters@127.0.0.1:5433/flymasters

# One secret for the whole platform. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server refuses to boot in production without it.
JWT_SECRET=

# How long a staff access token lives. Minutes, not days: an access token cannot be revoked, so this
# is the window a copied one stays useful. A rotating refresh token issues the next one, and that one
# can be revoked. Leave these alone unless there is a reason; raising ACCESS_TOKEN_TTL gives back
# exactly the exposure the short token removes.
ACCESS_TOKEN_TTL=15m
# How long a staff sign-in lasts without being used (days).
REFRESH_TOKEN_TTL_DAYS=30

PORT=8788

# ---------------------------------------------------------------------------
# Account creation gates (leave unset to switch self-signup off)
# ---------------------------------------------------------------------------
ADMIN_SIGNUP_CODE=
ADMIN_SIGNUP_OPEN=false
TELECALLER_SIGNUP_CODE=
# Not used any more: counselor accounts are created by an admin (Admin > Users).
COUNSELOR_SIGNUP_CODE=

# ---------------------------------------------------------------------------
# Launch switches (see docs/release/permission-matrix.md, Part C)
# ---------------------------------------------------------------------------
# An Admin sees and changes only the branches they are assigned to. Must be true for launch.
ADMIN_SCOPE_ENFORCED=true
# Strict role and branch checks at sign-in. Undecided: settle it before staging.
IDENTITY_STRICT=
# HR (attendance, leave, salary) is not part of the initial release. Leave unset or false.
# The client must also be BUILT with VITE_HR_ENABLED unset or false to hide the HR screens.
HR_ENABLED=false
# Telecaller HR (clock-in, leave, salary) follows HR_ENABLED when unset. Set true to turn it on
# for telecallers alone, or false to keep it off even when HR_ENABLED is true.
TELECALLER_HR_ENABLED=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Only needed for the Capacitor mobile build or a split deployment during cutover.
ALLOWED_ORIGINS=

WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OUTREACH_TEMPLATE_NAME=

RESEND_API_KEY=
EMAIL_VERIFICATION_EXPIRY_MINUTES=10

UNASSIGNED_ALERT_HOURS=2
PG_POOL_MAX=10
