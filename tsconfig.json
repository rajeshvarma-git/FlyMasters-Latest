{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./src/shared/*"],
      "@admin/*": ["./src/portals/admin/*"],
      "@counselor/*": ["./src/portals/counselor/*"],
      "@telecaller/*": ["./src/portals/telecaller/*"],
      "@student/*": ["./src/portals/student/*"],
      "@partner/*": ["./src/portals/partner/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
