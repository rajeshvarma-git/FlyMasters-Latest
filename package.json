    "dev:web": "vite",
    "dev:api": "tsx server/index.mjs",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tsx server/index.mjs",
    "start:prod": "NODE_ENV=production tsx server/index.mjs",
    "migrate": "tsx -e \"import('./server/lib/migrate.mjs').then(m=>m.migrate()).then(n=>{console.log('migrations applied:',n);process.exit(0)})\"",
    "preview": "vite preview",
    "typecheck:staff": "tsc -p tsconfig.json --noEmit 2>&1 | grep -v \"src/portals/student/\" || true"
  },
